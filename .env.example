# Copy this file to .env.local and fill in the two values from
# Supabase > Project Settings > API Keys (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: show the "Continue with Google" button.
# Turn on Google in Supabase > Authentication > Sign In / Providers first (see README).
NEXT_PUBLIC_AUTH_GOOGLE=false
